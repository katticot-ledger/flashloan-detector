{
  "tasks": {
    "start": "deno run --allow-net src/main.ts",
    "dev": "deno run --watch --allow-net src/main.ts",
    "lint": "deno lint",
    "prettier": "npx prettier -c *",
    "fmt": "deno fmt"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  },
  "fmt": {
    "include": ["src/", "tests/"],
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "lint": {
    "files": {
      "include": ["src/", "tests/"],
      "exclude": ["src/testdata/"]
    },
    "rules": {
      "include": [
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "no-explicit-any"
      ]
    }
  }
}
